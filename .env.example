# Choose DATABASE_URL or the individual PostgreSQL variables below.
# DATABASE_URL takes precedence over PG* connection fields.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=backup
PGPASSWORD=
PGDATABASE=app
OUTPUT_DIR=./backups

# Optional libpq TLS configuration:
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/path/to/root.crt
